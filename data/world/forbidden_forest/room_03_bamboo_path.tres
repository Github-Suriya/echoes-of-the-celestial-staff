[gd_resource type="Resource" script_class="RoomData" format=3]

[ext_resource type="Script" path="res://scripts/world/room_data.gd" id="1_rdata"]

[resource]
script = ExtResource("1_rdata")
room_id = &"room_03_bamboo_path"
display_name = "Cursed Bamboo Path"
scene_path = "res://scenes/world/forbidden_forest/room_03_bamboo_path.tscn"
room_bounds = Rect2(0, 0, 2880, 1080)
spawn_point_ids = [&"spawn_from_grove", &"spawn_from_shrine"]
connections = {
"exit_to_grove": {
"destination_room_id": &"room_02_ancient_grove",
"destination_spawn_id": &"spawn_from_bamboo"
},
"exit_to_shrine": {
"destination_room_id": &"room_04_forgotten_shrine",
"destination_spawn_id": &"spawn_from_bamboo"
}
}
