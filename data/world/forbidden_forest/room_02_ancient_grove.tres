[gd_resource type="Resource" script_class="RoomData" format=3]

[ext_resource type="Script" path="res://scripts/world/room_data.gd" id="1_rdata"]

[resource]
script = ExtResource("1_rdata")
room_id = &"room_02_ancient_grove"
